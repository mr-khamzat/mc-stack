# HA Bot — пример конфигурации
# Скопируй этот файл в .env и заполни своими данными:
#   cp .env.example .env

# ─── Telegram ──────────────────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=7123456789:AAF-REPLACE_WITH_YOUR_BOT_TOKEN

# Твой Telegram user ID (узнать через @userinfobot)
ADMIN_ID=123456789

# ─── Home Assistant ────────────────────────────────────────────────────────
# URL твоего HA (без слэша в конце)
HA_URL=https://homeassistant.yourdomain.com

# Long-Lived Access Token из HA: Профиль → Security → Long-Lived Access Tokens
HA_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_WITH_YOUR_HA_TOKEN

# ─── Мини апс (WebApp) ─────────────────────────────────────────────────────
# Секретный токен для API мини апс — любая случайная строка (min 32 символа)
# Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(16))"
WEBAPP_TOKEN=REPLACE_WITH_RANDOM_SECRET_TOKEN

# Публичный HTTPS URL мини апс (твой домен + путь /ha-app/)
# Telegram требует HTTPS! Настрой nginx-прокси на порт 8766.
WEBAPP_URL=https://YOUR_DOMAIN/ha-app/

# Локальный путь к папке с webapp (обычно не менять)
WEBAPP_DIR=/opt/ha-bot/webapp

# ─── Права доступа ─────────────────────────────────────────────────────────
# HA-логины пользователей с правами admin в мини апс (через запятую)
# Остальные пользователи получат роль viewer
HA_WEBAPP_ADMINS=your_ha_username

# ─── Frigate (опционально) ─────────────────────────────────────────────────
# URL Frigate если используется распознавание лиц
# FRIGATE_URL=http://frigate:5000
