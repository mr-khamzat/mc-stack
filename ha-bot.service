# Systemd unit для HA Home Bot
# Установка:
#   cp ha-bot.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now ha-bot

[Unit]
Description=HA Home Bot + Mini App (Telegram bot + web server)
Documentation=https://github.com/mr-khamzat/mc-stack
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Рекомендуется создать отдельного пользователя:
#   useradd -r -s /sbin/nologin -d /opt/ha-bot habot
#   chown -R habot:habot /opt/ha-bot
# Затем раскомментировать строку ниже и удалить User=root
# User=habot

# ⚠️ Если не создал пользователя habot — временно можно оставить root,
# но это не рекомендуется в продакшене
User=root

WorkingDirectory=/opt/ha-bot

# Переменные окружения из .env файла
EnvironmentFile=/opt/ha-bot/.env

# Путь к Python (если используешь venv)
ExecStart=/opt/ha-bot/venv/bin/python3 /opt/ha-bot/ha_bot.py

# Если НЕ используешь venv (системный Python):
# ExecStart=/usr/bin/python3 /opt/ha-bot/ha_bot.py

# Автоматический рестарт при краше
Restart=always
RestartSec=10

# Логи: journalctl -u ha-bot -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ha-bot

[Install]
WantedBy=multi-user.target
