# Systemd unit для HA Home Bot
# Установка:
#   cp ha-bot.service /etc/systemd/system/
#   useradd -r -s /usr/sbin/nologin -d /opt/ha-bot habot
#   chown -R habot:habot /opt/ha-bot && chmod 640 /opt/ha-bot/.env
#   systemctl daemon-reload
#   systemctl enable --now ha-bot

[Unit]
Description=HA Home Bot + Mini App (Telegram bot + web server)
Documentation=https://github.com/mr-khamzat/mc-stack
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=habot
Group=habot

WorkingDirectory=/opt/ha-bot

# Переменные окружения из .env файла
EnvironmentFile=/opt/ha-bot/.env

# Путь к Python (если используешь venv)
ExecStart=/usr/bin/python3 /opt/ha-bot/bot.py


# Автоматический рестарт при краше
Restart=always
RestartSec=10

# Systemd security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/ha-bot
PrivateTmp=yes

# Логи: journalctl -u ha-bot -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ha-bot

[Install]
WantedBy=multi-user.target
